# 只能使用已修复 GHSA-mmg5-8x8q-v934 与 GHSA-2hjx-23vw-wvw4 的正式稳定版，并固定 digest。
LIGHTRAG_IMAGE=ghcr.io/hkuds/lightrag:REPLACE_STABLE_TAG@sha256:REPLACE_VERIFIED_DIGEST
LIGHTRAG_API_KEY=REPLACE_WITH_STRONG_SHARED_SECRET

# 每次启动一个实例时传入，例如 KB_ID=1934567890123456789。
KB_ID=REPLACE_WITH_KNOWLEDGE_BASE_ID

NEO4J_IMAGE=neo4j:5.26.18-community@sha256:REPLACE_VERIFIED_DIGEST
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

POSTGRES_HOST=ragent-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DATABASE=ragent

LLM_BINDING=openai
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=REPLACE_WITH_API_KEY
LLM_MODEL=qwen-plus
SUMMARY_LANGUAGE=简体中文

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BINDING_API_KEY=REPLACE_WITH_API_KEY
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1536
