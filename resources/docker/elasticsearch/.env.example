# 必须是 8.19.19 且固定 manifest digest，不允许 latest。
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.19@sha256:REPLACE_WITH_VERIFIED_DIGEST
# 下载 IK 8.19.19 后在受信环境计算；Docker 构建会强制复核。
IK_SHA256=REPLACE_WITH_VERIFIED_64_HEX_SHA256
IK_SHA256_SHORT=REPLACE_WITH_FIRST_12_HEX
ELASTIC_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ES_JAVA_OPTS=-Xms1g -Xmx1g
